{
  "name": "motley-devtools",
  "private": true,
  "description": "Local RQML requirements and traceability tooling for Motley firmware",
  "engines": {
    "node": "^22.22.0 || >=23.5.0"
  },
  "scripts": {
    "codex": "codex",
    "rqml": "rqml",
    "rqml:mcp": "rqml-mcp",
    "requirements:validate": "rqml validate requirements.rqml",
    "requirements:lint": "rqml lint requirements.rqml --strictness strict",
    "requirements:check": "rqml check requirements.rqml --strictness strict"
  },
  "devDependencies": {
    "@rqml/cli": "0.11.0",
    "@rqml/mcp": "0.8.0"
  }
}
