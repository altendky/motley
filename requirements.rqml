<?xml version='1.0' encoding='utf-8'?>
<rqml xmlns="https://rqml.org/schema/2.2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.2.0" docId="DOC-MOTLEY" status="draft" xsi:schemaLocation="https://rqml.org/schema/2.2.0 https://rqml.org/schema/rqml-2.2.0.xsd">
  <meta>
    <title>Motley requirements</title>
    <system>motley</system>
    <summary>Alternative requirements representation for comparison with OpenLore PR #2. All firmware requirements remain unimplemented. Stable requirement IDs and acceptance intent are preserved; tool-specific report wording is adapted to RQML.</summary>
  </meta>
  <goals>
    <goal id="GOAL-MOT-PLATFORM" title="Platform" status="draft" priority="must">
      <statement>Define Motley's initial controller and integration scope. These are intended requirements; firmware implementation and hardware verification are pending.</statement>
    </goal>
    <goal id="GOAL-MOT-SENSING" title="Wired sensing" status="draft" priority="must">
      <statement>Provide flexible remote temperature and humidity measurements without requiring special arrangements of sensor addresses or overlapping measurement locations. Implementation and physical cable validation are pending.</statement>
    </goal>
    <goal id="GOAL-MOT-ENGINEERING" title="Engineering constraints" status="draft" priority="must">
      <statement>Keep firmware straightforward, reviewable and correct. These constraints apply to project-owned application code; SDK boundaries require explicit adaptation.</statement>
    </goal>
    <goal id="GOAL-MOT-OUTPUT-CONTROL" title="Optional output control" status="draft" priority="must">
      <statement>Capture constraints for the discussed optional on/off control of an approximately 25 W, 120 V AC heater. Relay accessory selection, wiring, automatic regulation and implementation remain pending. This specification does not require a heater in the first sensor-only prototype.</statement>
    </goal>
  </goals>
  <requirements>
    <reqPackage id="PKG-MOT-PLATFORM" title="Platform">
      <description>Define Motley's initial controller and integration scope. These are intended requirements; firmware implementation and hardware verification are pending.</description>
      <req id="MOT-PLAT-001" type="FR" title="ESP32-C6 and supported Matter SDK" status="draft" priority="must">
        <statement>Motley SHALL initially target the Adafruit ESP32-C6 Feather, using modern C++ with ESP-IDF and Espressif's `esp-matter`. The build SHALL identify a compatible, pinned ESP-IDF, esp-matter and connectedhomeip combination.</statement>
        <acceptance>
          <!-- Reproducing a firmware build -->
          <criterion id="AC-MOT-PLAT-001-01">
            <when>a developer prepares the documented firmware toolchain</when>
            <then>the required SDK revisions and target are explicit AND the build does not silently select moving upstream branches</then>
          </criterion>
        </acceptance>
      </req>
      <req id="MOT-PLAT-002" type="FR" title="Home Assistant integration" status="draft" priority="must">
        <statement>Motley SHALL expose configured temperature and humidity measurements to Home Assistant through Matter over Thread. Each measurement SHALL have a stable identity across controller restarts with unchanged configuration. Commissioning state SHALL survive ordinary power cycles.</statement>
        <acceptance>
          <!-- Reporting after a power cycle -->
          <criterion id="AC-MOT-PLAT-002-01">
            <when>a commissioned controller loses power and restarts</when>
            <then>it reconnects without requiring a factory reset or recommissioning AND Home Assistant can read and subscribe to its configured measurements AND reporting is verified at Home Assistant, rather than inferred solely from successful local SDK calls</then>
          </criterion>
        </acceptance>
      </req>
      <req id="MOT-PLAT-003" type="FR" title="Initial scope and future capabilities" status="draft" priority="must">
        <statement>The initial platform SHALL support an externally powered controller with wired sensor heads. Thread router operation and long battery life SHALL remain future capabilities to evaluate, rather than initial acceptance criteria.</statement>
        <acceptance>
          <!-- Accepting the first sensor controller -->
          <criterion id="AC-MOT-PLAT-003-01">
            <when>wired sensing and Home Assistant reporting are demonstrated</when>
            <then>initial acceptance does not depend on router operation or a battery lifetime target</then>
          </criterion>
        </acceptance>
      </req>
    </reqPackage>
    <reqPackage id="PKG-MOT-SENSING" title="Wired sensing">
      <description>Provide flexible remote temperature and humidity measurements without requiring special arrangements of sensor addresses or overlapping measurement locations. Implementation and physical cable validation are pending.</description>
      <req id="MOT-SENS-001" type="FR" title="Independent measurement locations" status="draft" priority="must">
        <statement>Motley SHALL support an initial configuration with at least four temperature measurements and two relative-humidity measurements. Configuration SHALL describe each sensor's location, model and enabled measurements. Temperature and humidity locations SHALL be independently configurable; a combined sensor MAY provide both.</statement>
        <acceptance>
          <!-- Separate temperature and humidity locations -->
          <criterion id="AC-MOT-SENS-001-01">
            <when>four temperature locations and two different humidity locations are configured</when>
            <then>each measurement is associated with its configured location AND the configuration does not require paired temperature/humidity locations</then>
          </criterion>
        </acceptance>
      </req>
      <req id="MOT-SENS-002" type="FR" title="Multiplexed ports" status="draft" priority="must">
        <statement>The initial design SHALL support an Adafruit PCA9548 eight-channel STEMMA QT multiplexer and SHT45 sensor breakouts. Identical fixed-address sensors SHALL be usable on separate channels. A configured bus path SHALL identify each multiplexer address and selected channel, allowing later expansion without treating the sensor's I²C address as its unique identity.</statement>
        <acceptance>
          <!-- Two identical sensor addresses -->
          <criterion id="AC-MOT-SENS-002-01">
            <when>two SHT45 sensors occupy separate channels of one multiplexer</when>
            <then>each is read using its configured bus path AND channel selection prevents the other sensor from responding to that read</then>
          </criterion>
          <!-- Describing an expanded bus -->
          <criterion id="AC-MOT-SENS-002-02">
            <when>a later design uses parallel or cascaded multiplexers</when>
            <then>a sensor can be identified by the complete ordered bus path AND accepting that configuration still requires electrical and driver validation</then>
          </criterion>
        </acceptance>
      </req>
      <req id="MOT-SENS-003" type="FR" title="Remote wired sensor heads" status="draft" priority="must">
        <statement>Sensor heads SHALL connect by a four-conductor cable carrying power, ground, SDA and SCL to the controller or its expansion board. The initial cable validation target SHALL be approximately six feet per remote branch. Compatibility SHALL be established for the actual cable, supply, bus timing and installed sensor assembly.</statement>
        <acceptance>
          <!-- Qualifying the standard sensor cable -->
          <criterion id="AC-MOT-SENS-003-01">
            <when>the proposed six-foot cable and enclosed sensor head are tested</when>
            <then>successful and failed reads are observed under representative operation AND any required timing, pull-up or signal-conditioning constraints are recorded AND the multiplexer is not assumed to regenerate signals or reset cable limits</then>
          </criterion>
        </acceptance>
      </req>
      <req id="MOT-SENS-004" type="FR" title="Measurement validity" status="draft" priority="must">
        <statement>Motley SHALL distinguish successful, failed and stale measurements. It SHALL NOT publish a failed read as a new valid reading. Freshness limits and the external representation of unavailable measurements SHALL be explicit before acceptance.</statement>
        <acceptance>
          <!-- A remote sensor is disconnected -->
          <criterion id="AC-MOT-SENS-004-01">
            <when>a previously readable sensor stops responding</when>
            <then>its failure and measurement freshness are observable AND its last value is not presented indefinitely as a fresh measurement AND other sensor ports continue operating</then>
          </criterion>
        </acceptance>
      </req>
    </reqPackage>
    <reqPackage id="PKG-MOT-ENGINEERING" title="Engineering constraints">
      <description>Keep firmware straightforward, reviewable and correct. These constraints apply to project-owned application code; SDK boundaries require explicit adaptation.</description>
      <req id="MOT-ENG-001" type="NFR" title="Managed ownership and containers" status="draft" priority="must">
        <statement>Application code SHALL use values, references, RAII and standard containers such as `std::vector`. It SHALL avoid raw pointers, C arrays, manual allocation and manual resource cleanup. Unavoidable pointer or buffer interfaces imposed by ESP-IDF and Matter SHALL be isolated in small adapters with explicit ownership, lifetime and size contracts.</statement>
        <acceptance>
          <!-- Adapting an SDK callback -->
          <criterion id="AC-MOT-ENG-001-01">
            <when>an SDK API requires a raw context pointer or buffer</when>
            <then>the adapter contains that interface and documents its lifetime AND ordinary application logic operates through managed types</then>
          </criterion>
        </acceptance>
      </req>
      <req id="MOT-ENG-002" type="NFR" title="Correctness before optimization" status="draft" priority="must">
        <statement>Implementation SHALL favor clear control flow, explicit error handling and defined initialization and failure behavior. Optimization SHALL be justified by a measured constraint while preserving the agreed behavior. Resource allocation and synchronization failures SHALL have defined handling.</statement>
        <acceptance>
          <!-- A hardware operation fails -->
          <criterion id="AC-MOT-ENG-002-01">
            <when>a sensor, bus or output operation returns an error</when>
            <then>the caller receives or handles that failure explicitly AND success is not assumed from a requested operation alone</then>
          </criterion>
        </acceptance>
      </req>
      <req id="MOT-ENG-003" type="NFR" title="Requirements and verification evidence" status="draft" priority="must">
        <statement>Agreed behavior SHALL remain in maintained requirements with stable project IDs. Implemented requirements SHALL link to specific implementation symbols and relevant tests where available. Unimplemented requirements SHALL remain visible without invented implementation links. Mapping, structural analysis and observed test results SHALL be recorded as distinct evidence.</statement>
        <acceptance>
          <!-- Changing a requirement implemented by shared code -->
          <criterion id="AC-MOT-ENG-003-01">
            <when>an agreed behavior changes</when>
            <then>its implementation links and source consumers are inspected AND other affected requirements are identified as preservation constraints AND verification records identify the commands, results and tested content AND a clean RQML report alone is not treated as proof of correctness</then>
          </criterion>
        </acceptance>
      </req>
    </reqPackage>
    <reqPackage id="PKG-MOT-OUTPUT-CONTROL" title="Optional output control">
      <description>Capture constraints for the discussed optional on/off control of an approximately 25 W, 120 V AC heater. Relay accessory selection, wiring, automatic regulation and implementation remain pending. This specification does not require a heater in the first sensor-only prototype.</description>
      <req id="MOT-OUT-001" type="FR" title="External switching hardware" status="draft" priority="must">
        <statement>When heater control is enabled, Motley SHALL control an appropriately rated external switching accessory through its low-voltage interface. The controller board SHALL NOT directly switch or carry the heater's mains supply.</statement>
        <acceptance>
          <!-- Selecting a heater output -->
          <criterion id="AC-MOT-OUT-001-01">
            <when>heater switching is added to a controller configuration</when>
            <then>the switching accessory and its electrical ratings are identified AND the controller's GPIO drives only the accessory's low-voltage interface</then>
          </criterion>
        </acceptance>
      </req>
      <req id="MOT-OUT-002" type="FR" title="Defined de-energized state" status="draft" priority="must">
        <statement>An enabled heater output SHALL initialize to off and remain off until its configuration is valid and an explicit control action enables it. If automatic temperature regulation is implemented, its output SHALL turn off when the controlling measurement is invalid or stale. Software control SHALL NOT replace independent thermal protection.</statement>
        <acceptance>
          <!-- Controller restart -->
          <criterion id="AC-MOT-OUT-002-01">
            <when>the controller powers up or resets</when>
            <then>the heater output is off before normal control begins AND output initialization and reset behavior are verified on the chosen hardware</then>
          </criterion>
          <!-- Feedback failure during automatic regulation -->
          <criterion id="AC-MOT-OUT-002-02">
            <when>an enabled automatic controller loses valid temperature feedback</when>
            <then>it requests the heater output off AND the failure is observable</then>
          </criterion>
        </acceptance>
      </req>
    </reqPackage>
  </requirements>
  <trace>
    <edge id="TRACE-MOT-PLAT-001" type="satisfies" from="MOT-PLAT-001" to="GOAL-MOT-PLATFORM" />
    <edge id="TRACE-MOT-PLAT-002" type="satisfies" from="MOT-PLAT-002" to="GOAL-MOT-PLATFORM" />
    <edge id="TRACE-MOT-PLAT-003" type="satisfies" from="MOT-PLAT-003" to="GOAL-MOT-PLATFORM" />
    <edge id="TRACE-MOT-SENS-001" type="satisfies" from="MOT-SENS-001" to="GOAL-MOT-SENSING" />
    <edge id="TRACE-MOT-SENS-002" type="satisfies" from="MOT-SENS-002" to="GOAL-MOT-SENSING" />
    <edge id="TRACE-MOT-SENS-003" type="satisfies" from="MOT-SENS-003" to="GOAL-MOT-SENSING" />
    <edge id="TRACE-MOT-SENS-004" type="satisfies" from="MOT-SENS-004" to="GOAL-MOT-SENSING" />
    <edge id="TRACE-MOT-ENG-001" type="satisfies" from="MOT-ENG-001" to="GOAL-MOT-ENGINEERING" />
    <edge id="TRACE-MOT-ENG-002" type="satisfies" from="MOT-ENG-002" to="GOAL-MOT-ENGINEERING" />
    <edge id="TRACE-MOT-ENG-003" type="satisfies" from="MOT-ENG-003" to="GOAL-MOT-ENGINEERING" />
    <edge id="TRACE-MOT-OUT-001" type="satisfies" from="MOT-OUT-001" to="GOAL-MOT-OUTPUT-CONTROL" />
    <edge id="TRACE-MOT-OUT-002" type="satisfies" from="MOT-OUT-002" to="GOAL-MOT-OUTPUT-CONTROL" />
  </trace>
</rqml>
