	(text "04.1  HEATER CHANNEL - 120 VAC RESISTIVE LOAD, 300 W TARGET"
		(exclude_from_sim no)
		(at 15 15 0)
		(effects
			(font
				(size 1.9 1.9)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "049831ff-5ad2-50df-aba7-937d73e8b3c1")
	)
	(text "LOW90-132V: R104/R109=1k2; R110/R111DNP; R112/R113=0R fitted (2.4k total).\nHIGH180-264V: R104/R109/R110/R111=1k2; R112/R113DNP (4.8k total).\nGate and snubber PR02 pulse parts; C101+C104=9.4nF. Firmware must bound failed-latch retries/cutoff.\nCurrent path: CUT_L_UNSENSED -> sensor -> OUTLET_L. Timing, temperature, surges and EMI unqualified." (exclude_from_sim no) (at 15 192 0) (effects (font (size 1 1)) (justify left top)) (uuid "22d21fe0-4223-5441-8218-31fca1f969ac"))
	(text "LOCAL MCU DRIVERS: blocking diodes; 10k B-E bias.\nGate filter 1n / relay filter 100n. R102 470 / R106 200.\nDefaults, drive and release timing remain UNQUALIFIED." (exclude_from_sim no) (at 15 32 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid "34eedc19-f815-5404-a2f4-8321bdc72446"))
	(text "Normally hold relay ON; triac modulates heat. Coil 5 V / about 36 mA.\nNormal relay changes with triac OFF; interrupt load after triac fault.\nCommands HIGH = ON; flyback delays release. Verify actual timing." (exclude_from_sim no) (at 15 180 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "397cba46-1758-56ac-b6b4-343795e27753"))
	(text "LOW VOLTAGE: local MCU, blocking diodes, 10k B-E bias; gate 1n / relay 100n filters, unqualified"
		(exclude_from_sim no)
		(at 15 25 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "4910f2ea-569a-5736-872d-35de555ce392")
	)
	(text "J20: TWO CLOSED-TOP SHUNTS (DEFAULT ON)\nON: 1-2 + 3-4; OFF: 1-3 + 2-4\nBoth caps stay fitted; rotate BOTH by 90 degrees.\nUnplug and discharge before changing.\nHeader / shunt fit and mains spacing provisional."
		(exclude_from_sim no)
		(at 210.82 149.86 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "b88bd669-cff7-5350-ae15-9a4b84293b73")
	)
	(text "MAINS / ISOLATION\nA1 is live, never low-voltage GND.\nHeatsink and clip on insulated tab.\nRC fitted; J20 sets ON/OFF. Values provisional."
		(exclude_from_sim no)
		(at 160 151 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "e1c49d33-331a-520f-88bf-d418a72c5641")
	)
