	(text "R55/R56 FITTED = each upstream 4.7k pull-up enabled. Remove either 0-ohm link independently.\nR1 reset pull-up stays connected; J12/J13 retain remote reset.\nAddress = 0x70 + A0 + 2*A1 + 4*A2. Lever 1 = +1; lever 2 = +2; lever 3 = +4.\nAll OFF = 0x70. CTS MSTR factory setting is ON: set desired address UNPOWERED.\nAssign every mux on one upstream bus a unique address; downstream ports remain switched."
		(exclude_from_sim no)
		(at 20 152 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
