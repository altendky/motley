	(text "ACPL-K376 detects input magnitude; LINE_SYNC has a gap around each AC zero crossing.\nUse both edges and a qualified/calibrated timing model; this is not an exact zero-voltage comparator.\nMissing/invalid reference inhibits firing in both modes. All output modules must share this AC source/phase."
		(exclude_from_sim no)
		(at 15 139.7 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left top)
		)
		(uuid "c1fdff55-71d0-5ef3-bf78-9a619cd96041")
	)
	(text "SHARED ISOLATED LINE REFERENCE - SAME AC SOURCE / PHASE"
		(exclude_from_sim no)
		(at 15 15 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "d352901d-c89d-5767-a6e7-e811c5b3c3cb")
	)
	(text "4 x 17k = 68k: illustrative dissipation about 0.21 W total at120Vac and1.03 W at264Vac.\nR84 supply filtering: detector VCC/threshold guaranteed ranges, tolerance and transients require review.\nReinforced-isolation spacing, resistor voltage/pulse ratings and timing remain UNQUALIFIED; no PCB routing."
		(exclude_from_sim no)
		(at 15 167.64 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left top)
		)
		(uuid "e40e1b20-28f1-5466-b0da-bb236944e46e")
	)
