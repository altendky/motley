	(gr_text "LV LEFT / MAINS RIGHT\nAC input J17 and output J10 at bottom right.\nFront-side components and touch/probe access.\nFour copper layers; provisional routing."
		(at 141 45 0)
		(layer "Dwgs.User")
		(uuid "dc324ba9-75b5-4b68-a2ad-464145993932")
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.12)
			)
			(justify left top)
		)
	)
	(gr_text "PRESERVED RESERVES\n35 x 29 mm heatsink at upper right.\n5 mm provisional LV/mains copper rule.\nMounting hardware remains a mechanical study.\nNot a fabrication or energized-use release."
		(at 141 70 0)
		(layer "Dwgs.User")
		(uuid "4da1c9f9-0039-4a77-9dc6-0cfdd86efb4b")
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.12)
			)
			(justify left top)
		)
	)
	(gr_text "ROUTING / REVIEW\n2 mm load trunks with short package fanouts.\nLV-only ground copper; no PE bond.\nExact current/insulation/thermal qualification open.\n100 mm remains a target maximum, not this size."
		(at 141 98 0)
		(layer "Dwgs.User")
		(uuid "75e6dc96-ca90-42ce-811b-7058d13395bb")
		(effects
			(font
