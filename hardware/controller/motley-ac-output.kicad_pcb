	)
	(gr_text "ONE OUTPUT PER BOARD\nUse two identical copies for this device.\nTop-side assembly and touch/probe access.\nGroups remain movable; no tracks or pours."
		(at 151 49 0)
		(layer "Dwgs.User")
		(uuid "5ee33e20-b7d9-4338-9058-9f8fd3ffe164")
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.12)
			)
			(justify left top)
		)
	)
	(gr_text "LOW-VOLTAGE LINK - J14\n1 GND   2 selected logic 5 V\n3 SDA   4 SCL   5 SYNC\n6 raw mains-derived actuator 5 V\nUSB can power logic without actuator power."
		(at 151 70 0)
		(layer "Dwgs.User")
		(uuid "aa0616c2-e4ed-4712-92a5-356e642cd4ec")
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.12)
			)
			(justify left top)
		)
	)
	(gr_text "RECOVERY\nClose SW20, reset with SW21.\nOnly one responder at default address 0x64.\nReturn SW20 to RUN, then reset.\nFactory boot options still need qualification."
		(at 151 96 0)
		(layer "Dwgs.User")
		(uuid "fa7ff436-1ab6-487a-97f8-2131978b75b9")
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.12)
			)
			(justify left top)
		)
	)
	(gr_text "OPTIONAL LV CLIP LOOPS\nTP2 GND / TP3 raw 5 V\nTP4 gate / TP5 relay command\nTP20 3V3 / TP21 SYNC\nTP22 current / TP23 current reference\nTP24 outlet-voltage pulses\nTP1 is the top-side ground touch pad."
		(at 151 121 0)
		(layer "Dwgs.User")
		(uuid "8455c9a3-a31f-438b-84c8-87f59751cb10")
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.12)
			)
			(justify left top)
		)
	)
	(gr_text "THERMAL / DETECTOR STUDY\nRectangle reserves 35 x 29 mm heatsink space.\nClip, interface and height remain unqualified.\nDefault detector parts: 90-132 VAC assembly.\nHigh-line variant needs complete rating review."
		(at 151 153 0)
		(layer "Dwgs.User")
		(uuid "2ca36272-1f39-46a6-943b-3c62b9b1cba0")
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.12)
			)
			(justify left top)
		)
	)
	(gr_text "INTELLIGENT AC OUTPUT - ONE OUTLET / BUILD TWO"
		(at 90 35 0)
		(layer "Dwgs.User")
		(uuid "5aacf13a-fef9-4fe6-91e8-c5ba140625fd")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.12)
			)
		)
	)
