	(text "Unrouted exploratory protection; residual clamp, powered-off behavior and system immunity remain UNQUALIFIED."
		(exclude_from_sim no)
		(at 15 24 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "85c8e114-2555-51ac-93d1-bc65666292a4")
	)
	(text "TOUCH / CLIP ACCESS: local low-voltage reference only, no PE bond. Equalization is not earth discharge.\nBare two-hole same-net clip pads accept OPTIONAL hand-formed wire loops; no purchased contact required.\nNo permission for exposed energized mains handling or grounded test equipment on live mains.\nPlace clamps at their connectors, with short broad local returns; component ratings do not qualify this board."
		(exclude_from_sim no)
		(at 15 254 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
