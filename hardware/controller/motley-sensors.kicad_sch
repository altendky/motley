	(text "PROVISIONAL J12: 1 GND; 2 +3V3_SENS; 3 SDA; 4 SCL; 5 RESET_N.\nMatches carrier J13. Interface is low voltage only; no 5 V or mains.\nMux core behind first five ports; trim tail for 5..8 ports."
		(exclude_from_sim no)
		(at 20 145 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "9314fe4b-0bce-48e1-9e4c-e8618d5e2b90")
	)
	(text "J10/J11: parallel upstream Qwiic; R50 links their shared power to the local rail.\nJ12/J13: parallel five-pin deployment, including shared RESET_N.\nStandalone bench: disconnect the carrier/other host and supply. One host and one supply.\nPower links do not isolate SDA/SCL or separate external sources from each other.\nSet unique address DIP values with power OFF; configure upstream pulls for the complete bus."
		(exclude_from_sim no)
		(at 15 29.21 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
