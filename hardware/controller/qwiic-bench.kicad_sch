	(text "LP I2C: GPIO6 SDA / GPIO7 SCL - SECOND SOCKET (parallel)"
		(exclude_from_sim no)
		(at 296.86 217.8 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "51f549be-64e4-54be-b8e0-41a12537cf34")
	)
	(text "R44-R47 independently disconnect socket power, NOT SDA/SCL. Do not connect another powered host or drive signals into an unpowered board." (exclude_from_sim no) (at 15 381 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "61f6dc6d-0a02-5f58-98a8-46d81f745831"))
	(text "One pull-up pair per bus: main 10k, LP 4k7. Configure aggregate pulls when chaining muxes; check LOW current, rise time and cable power drop." (exclude_from_sim no) (at 15 395 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "6566bbe5-4c60-5051-be13-43113151dd1c"))
	(text "MAIN I2C: GPIO19 SDA / GPIO18 SCL - FIRST SOCKET / LOCAL PULL-UPS"
		(exclude_from_sim no)
		(at 20 40 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "66d98d61-c56c-5758-8d79-3acc742c4eac")
	)
	(text "LP output/bench bus: R42/R43 pull-ups and J24/J26 removable power links use main +3V3.\nHP sensor/bench bus remains on switched +3V3_SENS. Do not join the two power domains.\nOne controller/source per bus; Qwiic does not carry the separate LINE_SYNC or raw actuator 5 V." (exclude_from_sim no) (at 15 362 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid "6cbfb13e-4c21-598b-b31c-0927736294d6"))
	(text "Each horizontal pair shares one bus. Main and LP controllers remain independent. HP sockets source switched +3V3_SENS; LP sockets source main +3V3."
		(exclude_from_sim no)
		(at 15 25 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "955c1cf1-3536-501f-9fe1-e17a80eebda1")
	)
	(text "CARRIER: TWO I2C BUSES, TWO QWIIC SOCKETS PER BUS"
		(exclude_from_sim no)
		(at 15 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "aa8a6f36-fcc1-59dd-8c5d-d885ebe1e9c6")
	)
	(text "MAIN I2C: GPIO19 SDA / GPIO18 SCL - SECOND SOCKET (parallel)"
		(exclude_from_sim no)
		(at 296.86 40 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "c8aaf4ac-025e-5111-ad3c-3e52606c00b2")
	)
	(text "Five-pin deployment/reset link retained. LP GPIO6/7 preserve USB-JTAG policy. No firmware, hot-plug or ESD-immunity qualification is claimed." (exclude_from_sim no) (at 15 402 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "dfcdff88-79d3-5914-94ac-7738bbb66945"))
	(text "SUPPORTED BENCH USE: 3.3 V OUT only; one host and one supply per connected bus. Avoid loops between parallel sockets, chains and branches." (exclude_from_sim no) (at 15 374 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "eb37c970-424f-5b25-a371-5d0a57c68933"))
	(text "Enable +3V3_SENS before HP sensor I2C; LP bus remains powered. Review each domain current budget. At most one SHT45 heater pulse; deselecting a branch does not stop its pulse." (exclude_from_sim no) (at 15 388 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "f9df6b5e-04cf-5efd-8cac-ee9aa19111db"))
	(text "LP I2C: GPIO6 SDA / GPIO7 SCL - FIRST SOCKET / LOCAL PULL-UPS"
