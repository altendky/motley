	(gr_text "ANTENNA\nKeep copper, metal and cables clear.\nAntenna reserve and enclosure fit are provisional."
		(at 151 47 0)
		(layer "Dwgs.User")
		(uuid "1c99afc5-a2e6-4205-b3a2-f813e2865fb0")
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.12)
			)
			(justify left top)
		)
	)
	(gr_text "OUTPUT INTERFACES\nJ15/J18 are parallel six-pin LV links:\n1 GND / 2 selected logic 5 V\n3 SDA / 4 SCL / 5 SYNC\n6 raw mains-derived actuator 5 V.\nJ16/J19 carry mains separately."
		(at 151 68 0)
		(layer "Dwgs.User")
		(uuid "1f52b95f-1222-4662-8de5-c651624f39e5")
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.12)
			)
			(justify left top)
		)
	)
	(gr_text "POWER AND BENCH PORTS\nHP Qwiic and sensor link: switched sensor 3V3.\nLP Qwiic/output bus: controller logic 3V3.\nOne controlling host and one source per bus.\nCurrent, USB and cable budgets unqualified."
		(at 151 99 0)
		(layer "Dwgs.User")
		(uuid "77a3e32b-860c-43ff-bb10-725d482f31b8")
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.12)
			)
			(justify left top)
		)
	)
	(gr_text "PANEL USB\nJ21: Adafruit 6153 harness placeholder.\nShielding, retention and robustness remain open.\nUSB powers logic; raw actuator rail stays separate."
		(at 151 125 0)
		(layer "Dwgs.User")
		(uuid "8b7e161f-17da-466e-9cee-665f46019617")
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.12)
			)
			(justify left top)
		)
	)
	(gr_text "UNROUTED STUDY\nNot a fabrication or mains-qualified design.\nIsolation spacing and line-reference timing\nrequire review with the final routing/enclosure."
		(at 151 148 0)
		(layer "Dwgs.User")
		(uuid "a8884a4b-4cd6-414e-a772-c5e61756744e")
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.12)
			)
			(justify left top)
		)
	)
