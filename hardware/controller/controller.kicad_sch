  (global_label "UART_RX" (shape bidirectional) (at 332.74 142.24 180) (effects (font (size 1 1)) (justify right)) (uuid "0e11e747-c32c-5a3d-9284-1d17d729f7f6") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 332.74 142.24 180) (effects (font (size 1 1)) (hide yes))))
  (text "GPIO MAP / PROVISIONAL" (at 15 162 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "6d2560f9-524b-59e9-8187-b38cb76bcdcc"))
  (text "GPIO1/2 = heat 1/2; GPIO3/0 = cutoff 1/2.\nGPIO18/19 = SCL/SDA; GPIO21 = open-drain mux RESET_N.\nGPIO11 enables the sensor regulator; local 10k holds EN LOW.\nGPIO12/13 = native USB D-/D+; GPIO10 = status LED." (at 15 170 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "ccf8688f-27fd-5c86-8735-b94c23910054"))
  (text "SENSOR POWER DOMAIN" (at 155 192 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "ad8963c8-ac53-5a2b-b0fd-929fb3980182"))
  (text "Mux, upstream pull-ups and all probe ports run from +3V3_SENS.\nKeep SDA, SCL and RESET_N high impedance while that rail is OFF;\ndisable internal pull-ups, then enable power and wait before I2C.\nGPIO18/19/21 reset pulls remain an OPEN off-domain issue; qualify before build." (at 155 200 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "343f6f01-c4ff-5fd8-b228-c96470c18f4a"))
  (text "PLACEMENT / QUALIFICATION" (at 15 220 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "1b58b74c-903f-58ab-b323-ec78d98f24e0"))
  (text "WROOM pin map and local footprint derive from Espressif library tag 3.0.1.\nKeep the antenna clear of copper, components, enclosure metal and cables.\nPower/thermal/USB budgets and recovery behavior require hardware validation.\nUnrouted exploratory drawing; no manufacturing or mains approval." (at 15 228 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "f8dfa7d7-d3a6-5e3e-81bb-6b3660dc47ad"))
