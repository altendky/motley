		(uuid "1b58b74c-903f-58ab-b323-ec78d98f24e0")
	)
	(text "EN: 10k / 1u RC per Espressif starting circuit.\nHold BOOT, pulse RESET, release BOOT for ROM recovery."
		(exclude_from_sim no)
		(at 15 108 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "3284a483-994c-5286-b6e2-cf7d7fe573bb")
	)
	(text "Mux, upstream pull-ups and all probe ports run from +3V3_SENS.\nKeep SDA, SCL and RESET_N high impedance while that rail is OFF;\ndisable internal pull-ups, then enable power and wait before I2C.\nGPIO18/19/21 reset pulls remain an OPEN off-domain issue; qualify before build."
		(exclude_from_sim no)
		(at 155 200 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "343f6f01-c4ff-5fd8-b228-c96470c18f4a")
	)
	(text "GPIO6/7 = output LP I2C SDA/SCL; GPIO1 = LINE_SYNC input through R87.\nGPIO18/19 = sensor SCL/SDA; GPIO21 = open-drain mux RESET_N.\nGPIO11 = sensor power EN, default LOW; GPIO4/2/3/0 are now NC.\nGPIO12/13 = native USB D-/D+; GPIO10 = status LED.\nOutput MCU owns gate timing, feedback and relay; no actuation firmware here."
		(exclude_from_sim no)
		(at 15 170 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "4dcc47cd-9ded-55dd-944e-191dd87defd1")
	)
	(text "GPIO MAP / PROVISIONAL"
		(exclude_from_sim no)
		(at 15 162 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "6d2560f9-524b-59e9-8187-b38cb76bcdcc")
	)
	(text "SENSOR POWER DOMAIN"
		(exclude_from_sim no)
		(at 155 192 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "ad8963c8-ac53-5a2b-b0fd-929fb3980182")
	)
	(text "LP OUTPUT/QWIIC: GPIO6 SDA / GPIO7 SCL. Pull-ups and socket power use main +3V3.\nHP sensor bus stays switched. Use USB Serial/JTAG; assess LP reset and SDK support."
		(exclude_from_sim no)
		(at 240 235 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "c201b4bd-6765-54c1-834c-a7dc25451f31")
	)
	(text "INTEGRATED ESP32-C6-WROOM-1-N8 / 8 MB FLASH"
		(exclude_from_sim no)
		(at 15 15 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "e6e2184b-08fe-5501-8bd5-add809ff123b")
	)
	(text "Study circuit: USB serial/JTAG and ROM recovery; no battery circuitry or internal USB source port."
		(exclude_from_sim no)
		(at 15 23 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "e88f82cf-cb58-5175-ae31-ae82e5e73671")
	)
	(text "WROOM pin map and local footprint derive from Espressif library tag 3.0.1.\nKeep the antenna clear of copper, components, enclosure metal and cables.\nPower/thermal/USB budgets and recovery behavior require hardware validation.\nUnrouted exploratory drawing; no manufacturing or mains approval."
		(exclude_from_sim no)
		(at 15 228 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "f8dfa7d7-d3a6-5e3e-81bb-6b3660dc47ad")
	)
