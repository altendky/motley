{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "rebaseWhen": "conflicted",
  "enabledManagers": ["github-actions", "mise", "pre-commit"],
  "pre-commit": { "enabled": true },
  // Native package graphs are updated with mise.lock, not as extra manifests.
  "ignorePaths": [
    "**/node_modules/**", "**/bower_components/**", "**/vendor/**",
    "**/examples/**", "**/__tests__/**", "**/test/**", "**/tests/**",
    "**/__fixtures__/**", "**/.mise/locks/**"
  ],
  "packageRules": [
    {
      "description": "Keep Node on the selected major release",
      "matchManagers": ["mise"],
      "matchPackageNames": ["node"],
      "allowedVersions": "/^24(?:\\.|$)/"
    },
    {
      "description": "Keep Python on the selected minor release",
      "matchManagers": ["mise"],
      "matchPackageNames": ["python"],
      "allowedVersions": "/^3\\.14(?:\\.|$)/"
    },
    {
      "matchManagers": ["mise"],
      "postUpgradeTasks": {
        "commands": [
          "env MISE_LOCKED=0 mise install --yes node python",
          "env MISE_LOCKED=0 mise lock --yes --platform linux-x64,linux-arm64,macos-x64,macos-arm64,windows-x64"
        ],
        "fileFilters": ["mise.lock", ".mise/locks/**"],
        "executionMode": "branch"
      }
    }
  ]
}
